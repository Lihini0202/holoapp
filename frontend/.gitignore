# --- Secrets -----------------------------------------------------------------
# .env is bundled as a Flutter asset, so it must hold only public keys. It is
# still not committed: the deployment platform supplies the values at build time.
.env
.env.*
!.env.example

# --- Build output ------------------------------------------------------------
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

