ios/Pods/
ios/.symlinks/
android/.gradle/
android/local.properties
android/key.properties
*.jks

# --- Editors and OS ----------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db
