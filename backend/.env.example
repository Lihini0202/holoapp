# Backend configuration. Copy to .env and fill in; .env is never committed.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
OPENROUTER_API_KEY=your-openrouter-key
# Local development reads the key file beside this one.
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
# Deployed environments set this instead: the whole key as a single-line secret,
# so there is no file to mount and no path to resolve. It takes precedence.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379
